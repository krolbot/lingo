{
  "name": "lingo",
  "version": "0.1.0",
  "description": "A small translation service for your own apps: translation memory, glossary, checks, and any OpenAI-compatible model.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "lingo": "bin/lingo.mjs"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build:admin": "vite build admin --base ./ --outDir ../dist/admin --emptyOutDir"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@gravity-ui/uikit": "8.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
